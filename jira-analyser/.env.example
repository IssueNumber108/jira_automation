# ── Jira connection ────────────────────────────────────────────────────
# Required: copy this file to .env and fill in your values.

JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_CERT_PATH=certs/cert.pem

# ── Optional tuning ────────────────────────────────────────────────────
JIRA_MAX_RESULTS_PER_PAGE=100
JIRA_REQUEST_TIMEOUT=30
JIRA_MAX_RETRIES=3

# ── Output ─────────────────────────────────────────────────────────────
OUTPUT_DIR=outputs
